<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<TextView
		android:id="@+id/textview1"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Name coming soon!"
		android:textSize="12sp"
		android:textColor="#000000"/>
	<TextView
		android:id="@+id/textview2"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Version 0.0.9"
		android:textSize="12sp"
		android:textColor="#000000"/>
	<CheckBox
		android:id="@+id/tutorial_checkbox"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Show tutorials"
		android:textSize="12sp"
		android:textColor="#000000"/>
	<Button
		android:id="@+id/play_btn"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Play"
		android:textSize="12sp"
		android:textColor="#000000"/>
	<Button
		android:id="@+id/deck_btn"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Edit deck"
		android:textSize="12sp"
		android:textColor="#000000"/>
	<Button
		android:id="@+id/language_btn"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Change language"
		android:textSize="12sp"
		android:textColor="#000000"/>
	<Button
		android:id="@+id/credits_btn"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Credits"
		android:textSize="12sp"
		android:textColor="#000000"/>
</LinearLayout>
