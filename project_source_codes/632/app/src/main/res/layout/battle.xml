<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/library_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Library size"
				android:textSize="12sp"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/discard_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Discard size"
				android:textSize="12sp"
				android:layout_weight="1" />
		</LinearLayout>
		<ListView
			android:id="@+id/entity_view"
			android:layout_width="match_parent"
			android:layout_height="360dp"
			android:padding="8dp"
			android:choiceMode="none"
			android:layout_weight="1"
			tools:listitem="@layout/entity" />
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/action_point_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Action point(\?)"
				android:textSize="14sp"
				android:layout_weight="1" />
			<Button
				android:id="@+id/next_turn_btn"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Next turn"
				android:textSize="12sp" />
		</LinearLayout>
		<TextView
			android:id="@+id/card_desc"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="Some description about the card..."
			android:textSize="12sp"
			android:lines="4" />
		<ListView
			android:id="@+id/card_view"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="8dp"
			android:choiceMode="none"
			android:layout_weight="3"
			tools:listitem="@layout/card" />
	</LinearLayout>
</LinearLayout>
